# ============================================================
#  Backend PyRofex (A3 Mercados) - variables de entorno
#  Copiar a .env y completar con las credenciales reales.
# ============================================================

# --- Credenciales requeridas (provistas por A3 Mercados / tu ALyC) ---
ROFEX_USER=
ROFEX_PASSWORD=
ROFEX_ACCOUNT=

# --- Endpoints REST y WebSocket ---
# Produccion (LIVE) A3:   https://api.cocos.xoms.com.ar  / wss://api.cocos.xoms.com.ar/
# Homologacion (REMARKET): https://api.remarkets.primary.com.ar / wss://api.remarkets.primary.com.ar/
ROFEX_API_URL=
ROFEX_WS_URL=

# --- Entorno: LIVE o REMARKET ---
ROFEX_ENVIRONMENT=LIVE

# --- Instrumentos a seguir ---
# Lista separada por comas. Si se deja vacio, el backend autodescubre los DLR/.
# Ej: DLR/JUN26,DLR/JUL26,DLR/AGO26
ROFEX_TICKERS=

# --- Tipo de cambio de referencia (opcional) ---
# Ticker del spot/A3500 si tu cuenta lo expone; sino usar los valores fijos de fallback.
SPOT_TICKER=
A3500_TICKER=
SPOT_VALUE=1477.0
A3500_VALUE=1477.3

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
BROADCAST_INTERVAL=1.0

# CORS: origenes permitidos (coma). Incluir tu dominio de Vercel.
# Ej: http://localhost:3000,https://tu-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
