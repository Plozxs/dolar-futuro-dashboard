# ============================================================
#  Frontend (Next.js) - variables de entorno
#  Copiar a .env.local y completar.
# ============================================================

# Modo de datos:
#   auto       -> intenta conectar al backend; si no responde, usa simulado (recomendado)
#   backend    -> exige el backend PyRofex (FastAPI)
#   simulated  -> ignora el backend y usa el feed simulado (ideal para la demo de Vercel)
NEXT_PUBLIC_DATA_MODE=auto

# URL del backend PyRofex (FastAPI). En Vercel dejar vacio para forzar modo simulado.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Endpoint WebSocket del backend para streaming en tiempo real.
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws
